# このファイルの役割：
#   .env（秘密情報を書くファイル）の見本です。
#   このファイルをコピーして「.env」という名前にし、= の右側に自分の値を書いてください。
#     Mac / Linux:  cp .env.example .env
#     Windows:      copy .env.example .env
#   .env は Git に入らない設定になっています。トークンを Git やチャットに貼らないでください。
#   値の調べ方は README の「2. Notion連携の準備」を見てください。

# Notion連携（インテグレーション）のトークン。「ntn_」で始まる長い文字列
NOTION_TOKEN=

# カレンダーのデータベースID（32文字の英数字）
NOTION_DATABASE_ID=

# カレンダーをタップしたときに開くURL。空のままならタップしても何も起きない。
# 例: NOTION_CALENDAR_OPEN_URL=https://www.notion.so/xxxxxxxx
# iPadでNotionアプリではなくSafariが開いてしまう場合は、先頭の「https://」を「notion://」に書き換える
NOTION_CALENDAR_OPEN_URL=
